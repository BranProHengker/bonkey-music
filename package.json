{
  "name": "bonkey-music",
  "version": "2.3.7",
  "description": "A modern Hi-Fi music player built with Tauri v2, Rust, and React",
  "author": "www.gutsi.my.id",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck": "tsc --noEmit",
